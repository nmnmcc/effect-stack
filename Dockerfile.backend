FROM node:24-slim AS deps
WORKDIR /app
RUN corepack enable
COPY package.json yarn.lock .yarnrc.yml ./
COPY apps/backend/package.json apps/backend/
COPY apps/frontend/package.json apps/frontend/
COPY packages/api/package.json packages/api/
RUN yarn workspaces focus @effect-stack/backend --production

FROM node:24-slim AS builder
WORKDIR /app
RUN corepack enable
COPY package.json yarn.lock .yarnrc.yml ./
COPY apps/backend/package.json apps/backend/
COPY apps/frontend/package.json apps/frontend/
COPY packages/api/package.json packages/api/
RUN yarn install
COPY tsconfig.base.json tsconfig.json ./
COPY packages/api packages/api
COPY apps/backend apps/backend
RUN cd apps/backend && npx rolldown -c

FROM node:24-slim AS migrate
WORKDIR /app
RUN corepack enable
COPY --from=builder /app/package.json /app/yarn.lock /app/.yarnrc.yml ./
COPY --from=builder /app/apps/backend/package.json apps/backend/
COPY --from=builder /app/apps/frontend/package.json apps/frontend/
COPY --from=builder /app/packages/api/package.json packages/api/
COPY --from=builder /app/node_modules node_modules
COPY apps/backend/drizzle.config.ts apps/backend/
COPY apps/backend/src/services/database/schema apps/backend/src/services/database/schema/
COPY apps/backend/src/services/database/migrations apps/backend/src/services/database/migrations/
ENTRYPOINT ["npx", "drizzle-kit", "migrate"]
WORKDIR /app/apps/backend

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules node_modules
COPY --from=builder /app/apps/backend/dist apps/backend/dist
EXPOSE 30000
CMD ["node", "--enable-source-maps", "apps/backend/dist/index.mjs"]
