{
  "name": "@effect-stack/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "build": "yarn generate && react-router build",
    "generate": "yarn generate:openapi && orval --config orval.config.ts",
    "generate:openapi": "tsx scripts/write-openapi.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@tanstack/react-query": "5.101.4",
    "better-auth": "1.7.0-rc.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@effect-stack/api": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "jsdom": "^27.4.0",
    "orval": "8.24.0",
    "shadcn": "^4.16.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
